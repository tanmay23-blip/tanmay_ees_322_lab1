    {
      "cell_type": "code",
      "source": [
        "Map=geemap.Map()\n",
        "Map.centerObject(aoi, 10)\n",
        "\n",
        "true_color={\n",
        "    'bands':['SR_B4', 'SR_B3', 'SR_B2'],\n",
        "    'min':0.0,\n",
        "    'max':0.30\n",
        "}\n",
        "\n",
