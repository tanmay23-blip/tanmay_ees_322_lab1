      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "samples = {\n",
        "    'Vegetation': ee.Geometry.Point([73.77356019002816, 24.580339427513646]),       # Hills/Forest area\n",
        "    'Water': ee.Geometry.Point([73.81613221151254, 24.569099346456674]),            # Bay / Water body\n",
        "    'Bare Soil / Built-up': ee.Geometry.Point([73.65065064412973,  24.51647612514387])  # Urban/Panvel center\n",
        "}\n",
        "\n",
        "bands = ['SR_B1', 'SR_B2', 'SR_B3', 'SR_B4', 'SR_B5', 'SR_B6', 'SR_B7']\n",
        "wavelength_um = [0.443, 0.482, 0.562, 0.655, 0.865, 1.609, 2.201]\n",
        "\n",
        "# 2. Add sample points to your geemap layout for visual verification\n",
        "for surface_name, pt in samples.items():\n",
        "    Map.addLayer(pt, {}, f'Sample: {surface_name}')\n",
        "\n",
        "# 3. Loop through each point and extract spectral reflectance\n",
        "spectral_list = []\n",
        "\n",
        "for surface_name, pt in samples.items():\n",
        "    sample_area = pt.buffer(45)\n",
        "\n",
        "    spectrum = (\n",
        "        image.select(bands)\n",
        "        .reduceRegion(\n",
        "            reducer=ee.Reducer.mean(),\n",
        "            geometry=sample_area,\n",
        "            scale=30,\n",
        "            maxPixels=1_000_000,\n",
        "        )\n",
        "        .getInfo()\n",
        "    )\n",
        "\n",
        "    # Get reflectance values for each band\n",
        "    reflectance = [spectrum.get(b, np.nan) for b in bands]\n",
        "\n",
        "    # Store in list\n",
        "    for w, r in zip(wavelength_um, reflectance):\n",
        "        spectral_list.append({\n",
        "            'Surface_Type': surface_name,\n",
        "            'Wavelength_um': w,\n",
        "            'Surface_reflectance': r\n",
        "        })\n",
        "\n",
        "# 4. Create master DataFrame\n",
        "spectral_df = pd.DataFrame(spectral_list)\n",
        "print(\"Extracted Spectral Data:\")\n",
        "display(spectral_df.head(21))\n",
        "\n",
        "# 5. Plot all 3 signatures on a single graph\n",
        "plt.figure(figsize=(9, 5))\n",
        "\n",
        "for surface_name, group in spectral_df.groupby('Surface_Type'):\n",
        "    plt.plot(\n",
        "        group['Wavelength_um'],\n",
        "        group['Surface_reflectance'],\n",
        "        marker='o',\n",
        "        linewidth=2,\n",
        "        label=surface_name\n",
        "    )\n",
        "\n",
        "plt.xlabel('Wavelength (micrometres)', fontsize=12)\n",
        "plt.ylabel('Surface Reflectance', fontsize=12)\n",
        "plt.title('Comparison of Spectral Signatures (Landsat 8 L2)', fontsize=14)\n",
        "plt.grid(True, linestyle='--', alpha=0.6)\n",
        "plt.legend(title='Surface Type', fontsize=11)\n",
        "plt.tight_layout()\n",
        "plt.show()"
      ],
